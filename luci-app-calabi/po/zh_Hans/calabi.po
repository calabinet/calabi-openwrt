msgstr "接管端点「%s」到本机"

msgid "This OpenWrt device will serve the endpoint. The previous client will stop serving it, and existing connections may be briefly interrupted."
msgstr "接管后将由这台 OpenWrt 设备提供端点服务，原客户端会停止提供该端点，现有连接可能短暂中断。"

msgid "Enter the address of the service reachable from this OpenWrt device."
msgstr "填写这台 OpenWrt 设备可以访问的服务地址。"

msgid "Enter a valid port or host:port."
msgstr "请输入有效的端口或主机:端口。"

msgid "Switch to the endpoint’s edge before taking it over to keep its external address."
msgstr "请先切换到该端点所在的边缘节点再接管，以保留外部地址。"

msgid "Unavailable for the current account or client."
msgstr "当前账号或客户端无法配置此项。"

msgid "Could not load access control permissions."
msgstr "无法读取访问控制权限。"

msgid "IP access control"
msgstr "IP 访问控制"

msgid "Allow or deny by source IP or CIDR, one entry per line. Rules are enforced at the edge."
msgstr "按来源 IP / CIDR 放行或拒绝（每行一条），在边缘节点强制生效。"

msgid "Basic authentication"
msgstr "Basic 认证"

msgid "Visitors must enter a username and password. Passwords are stored as hashes."
msgstr "访问服务前需输入用户名和密码。密码以哈希存储。"

msgid "Connection rate limits"
msgstr "速率限制"

msgid "Limit new connections to protect the upstream service. Zero or blank means unlimited."
msgstr "限制到本端点的新连接速率（保护上游服务）。0 或留空表示不限。"

msgid "Request header rewriting"
msgstr "请求头改写"

msgid "Rewrite headers forwarded upstream. Protocol headers such as Content-Length cannot be changed."
msgstr "改写转发给上游的请求头。Content-Length 等协议头不可改写。"

msgid "OAuth sign-in"
msgstr "OAuth 登录认证"

msgid "Require visitors to sign in with an identity provider."
msgstr "访问服务前需通过身份提供方登录。"

msgid "Custom addresses"
msgstr "自定义地址"

msgid "Address source"
msgstr "地址来源"

msgid "Allowlist — only these addresses may connect (blank allows all)"
msgstr "白名单——仅这些可访问（留空放行全部）"

msgid "Denylist — always blocked, even if allowlisted"
msgstr "黑名单——始终拒绝（优先级高于白名单）"

msgid "Follows organization policy “%s” and updates automatically when the policy changes."
msgstr "跟随组织策略「%s」，策略更新后本端点自动同步。"

msgid "Leave blank to keep the current password"
msgstr "留空保留现有密码"

msgid "e.g. 600"
msgstr "如 600"

msgid "A per-IP limit can prevent one source from using the entire endpoint allowance."
msgstr "建议同时设置单 IP 上限，避免单一来源占满整个端点的额度。"

msgid "per minute (entire endpoint)"
msgstr "次/分钟（整个端点）"

msgid "per minute (per source IP)"
msgstr "次/分钟（单个来源 IP）"

msgid "Set or add headers, replacing any existing values"
msgstr "设置 / 添加（覆盖同名头）"

msgid "Remove headers, one name per line"
msgstr "移除（每行一个头名）"

msgid "Provider (off)"
msgstr "提供方（关闭）"

msgid "Allowed email addresses (one per line, blank allows any signed-in user)"
msgstr "允许的邮箱（每行一个，留空允许任意已登录用户）"

msgid "Allowed email domains (one per line)"
msgstr "允许的邮箱域名（每行一个）"

msgid "Register this callback URL in your OAuth application."
msgstr "在你的 OAuth 应用里注册这个回调地址。"

msgid "Provider, Client ID and access rules follow organization policy “%s”."
msgstr "提供方、Client ID 和允许范围跟随组织登录策略「%s」。"

msgid "Configure this endpoint"
msgstr "本端点单独配置"

msgid "Unavailable for the current account or client: %s."
msgstr "当前账号或客户端无法配置：%s。"

msgid "%s endpoints forward raw bytes and support IP access control and connection rate limits. Basic authentication, OAuth and header rewriting apply to HTTP/HTTPS endpoints."
msgstr "%s 端点按字节原样转发，只支持 IP 访问控制和速率限制。Basic 认证、OAuth 登录认证和请求头改写适用于 HTTP/HTTPS 端点。"

msgid "Saved rules take effect immediately at the edge, without reconnecting."
msgstr "保存后在边缘节点即时生效，无需重连。"

msgid "Traffic"
msgstr "流量"

msgid "Received"
msgstr "接收"

msgid "Sent"
msgstr "发送"

msgid "Awaiting port assignment"
msgstr "等待分配端口"

msgid "A subdomain is assigned automatically."
msgstr "系统自动分配子域名。"

msgid "Allowlist"
msgstr "白名单"

msgid "Awaiting address"
msgstr "等待分配地址"

msgid "Previous step"
msgstr "上一步"

msgid "Use the address of a local or LAN service."
msgstr "请填写本机或局域网服务的地址。"

msgid "Back to endpoints"
msgstr "返回端点列表"

msgid "Basic authentication applies to HTTP/HTTPS endpoints."
msgstr "Basic 认证仅适用于 HTTP/HTTPS 端点。"

msgid "Checking the local service…"
msgstr "正在检测本地服务…"

msgid "Choose a rule that restricts access before creating this endpoint."
msgstr "请设置能限制访问的规则，再创建端点。"

msgid "Choose who can access this endpoint. You can change these settings later."
msgstr "选择谁可以访问此端点，创建后仍可调整。"

msgid "Complete"
msgstr "完成"

msgid "Create"
msgstr "创建"

msgid "Create another endpoint"
msgstr "再建一个端点"

msgid "Create the endpoint anyway? You can start the local service later."
msgstr "仍要创建端点吗？可以稍后启动本地服务。"

msgid "Endpoint created"
msgstr "端点已创建"

msgid "Endpoint created · address still unassigned"
msgstr "端点已创建 · 地址尚未分配"

msgid "Endpoint created · awaiting approval"
msgstr "端点已创建 · 等待审批"

msgid "Endpoint created · waiting for address"
msgstr "端点已创建 · 正在等待地址"

msgid "Endpoint name"
msgstr "端点名称"

msgid "Endpoint settings"
msgstr "端点设置"

msgid "Manage this endpoint in the web console or take it over first."
msgstr "请到用户后台管理此端点，或先接管到本机。"

msgid "Enter a valid subdomain prefix."
msgstr "请输入有效的子域名前缀。"

msgid "Enter an allowlist"
msgstr "手动填写白名单"

msgid "Enter an endpoint name."
msgstr "请输入端点名称。"

msgid "Enter an external port between 1024 and 65535."
msgstr "请输入 1024 至 65535 之间的外部端口。"

msgid "Enter at least one IP address or CIDR."
msgstr "请至少填写一条 IP 地址或 CIDR。"

msgid "Enter both the username and password."
msgstr "请同时填写用户名和密码。"

msgid "Follow an organization policy"
msgstr "跟随组织策略"

msgid "IP access control is unavailable for this account."
msgstr "当前账号无法配置 IP 访问控制。"

msgid "Keep waiting"
msgstr "继续等待"

msgid "Leave the prefix empty to use the domain itself."
msgstr "留空前缀时使用域名本身。"

msgid "Leave unconfigured"
msgstr "暂不设置"

msgid "Local service"
msgstr "本地服务"

msgid "Local service reachable in %s ms."
msgstr "本地服务可达，耗时 %s ms。"

msgid "Next"
msgstr "下一步"

msgid "OpenWrt connects to the local service over HTTPS."
msgstr "OpenWrt 通过 HTTPS 连接本地服务。"

msgid "Organization default"
msgstr "组织默认"

msgid "Organization endpoints: %s"
msgstr "组织已有 %s 个端点。"

msgid "Select a policy"
msgstr "选择策略"

msgid "Select a verified domain"
msgstr "选择已验证域名"

msgid "Select a verified domain for this edge."
msgstr "请选择当前边缘节点的已验证域名。"

msgid "The created endpoint could not be found"
msgstr "找不到刚创建的端点"

msgid "The organization requires access protection for this endpoint."
msgstr "组织要求此端点设置访问防护。"

msgid "This domain is already in use. Enter a prefix."
msgstr "此域名已被使用，请填写前缀。"

msgid "This edge has no verified domain."
msgstr "当前边缘节点没有已验证域名。"

msgid "TLS (requires a compatible edge and domain)"
msgstr "TLS（需兼容的边缘节点及域名）"

msgid "TLS passes through to the local service, which provides its own certificate."
msgstr "TLS 由本地服务终止，本地服务需提供自己的证书。"

msgid "Host alias requests"
msgstr "申请单 IP 替身"

msgid "This device cannot install stand-in address rules."
msgstr "此设备无法安装替身地址转发规则。"

msgid "Update the Calabi core to request stand-in addresses."
msgstr "更新 Calabi 核心后即可申请替身地址。"

msgid "Synchronizing approvals"
msgstr "正在同步审批状态"

msgid "Reconnecting to the mesh"
msgstr "正在重新连接组网"

msgid "Showing the last synchronized results."
msgstr "列表显示上次同步结果。"

msgid "Mesh status unavailable"
msgstr "暂无法读取组网状态"

msgid "Not published"
msgstr "未发布"

msgid "Subnet settings saved."
msgstr "子网设置已保存。"

msgid "Alias unavailable"
msgstr "暂未分配替身地址"

msgid "Add"
msgstr "添加"

msgid "Pending save"
msgstr "待保存"

msgid "Saving will also withdraw the stand-in requests covered only by the removed subnet."
msgstr "保存时也会撤回仅属于该子网的替身申请。"

msgid "Save subnet settings to apply additions and deletions."
msgstr "添加和删除将在保存子网设置后生效。"

msgid "Enter a single IPv4 address within a subnet listed above."
msgstr "请输入上方已列出的子网内的单个 IPv4 地址。"

msgid "Enter an IPv4 subnet from /24 to /32, or a single IPv4 address."
msgstr "请输入 /24 至 /32 的 IPv4 子网，或单个 IPv4 地址。"

msgid "Add a subnet or a single IPv4 address. An administrator approves routes before publishing."
msgstr "添加 IPv4 子网或单个 IPv4 地址。子网经管理员批准后发布。"

msgid "Enter the IPv4 address of one host in a subnet above, add it, then save. An administrator approves the request."
msgstr "填写上方子网内的单个 IPv4 地址，点「添加」后保存，再由管理员审批。"
